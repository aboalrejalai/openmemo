# OpenMemo Remote MCP Server Configuration (.env)
# Copy to .env (chmod 600 .env). If PASSWORD is left empty during 1-click deploy,
# a secure 24-character initial password is auto-generated and saved to
# /srv/proxy-data/.initial_password (and printed in container startup logs).

PASSWORD=
EXTERNAL_URL=https://memo.example.com
PORT=8080
TRUSTED_PROXIES=
MEMO_REPO_URL=https://github.com/aboalrejalai/openmemo.git
TZ=UTC
