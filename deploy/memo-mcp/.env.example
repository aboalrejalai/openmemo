# Copy to .env on the VPS (chmod 600). Never commit real secrets.
# Password: set once on the server (min 20 chars). Do not put the live value here.

# Required — shared password for mcp-auth-proxy human login (min 20 chars).
PASSWORD=

# Public URL the proxy advertises (must be https://).
EXTERNAL_URL=https://memo.example.com

# Comma-separated trusted proxy CIDRs (Compose memo-net subnet).
# TRUSTED_PROXIES=172.30.80.0/24
TRUSTED_PROXIES=

# SSH clone URL (deploy_key must unlock this repo).
MEMO_REPO_URL=git@github.com:YOUR_GITHUB_USER/openmemo.git

# Optional extra redaction patterns (JSON array). Example:
# MEMO_REDACT_CUSTOM_PATTERNS=[{"name":"second-brain-token","pattern":"(?i)9uezn-[a-z0-9-]+"}]
MEMO_REDACT_CUSTOM_PATTERNS=

# Do not set GOOGLE_*, GITHUB_*, or OIDC_* — password-only auth (owner 2026-11-13).
