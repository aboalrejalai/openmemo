#!/bin/sh
# Stdio MCP entry for Cursor / Agent Plugins. Resolves the vault the same way as bin/memo.
for py in /opt/homebrew/bin/python3 /usr/local/bin/python3 python3; do
  if command -v "$py" >/dev/null 2>&1; then PY="$py"; break; fi
done
[ -n "$PY" ] || exit 1

VAULT="${MEMO_VAULT:-}"
if [ -z "$VAULT" ] && [ -f "$HOME/.memo/settings.json" ]; then
  VAULT=$("$PY" -c 'import json,sys; print(json.load(open(sys.argv[1])).get("vault",""))' "$HOME/.memo/settings.json" 2>/dev/null)
fi
[ -n "$VAULT" ] || VAULT="${OPENMEMO_HOME:-$HOME/openmemo}"

SERVER="$VAULT/scripts/mcp_server.py"
[ -f "$SERVER" ] || exit 1
exec "$PY" "$SERVER"
